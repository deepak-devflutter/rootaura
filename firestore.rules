rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null;
    }

    // Admin = email in the allow-list OR users/{uid}.role == 'admin'.
    // TODO(client): add the real admin email(s) here AND in ShopConfig.
    function adminEmails() {
      return ['owner@example.com'];
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in adminEmails() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ---- products: public read; admin full write; signed-in users may only
    // decrement `stock` (for order placement). Any other field change, or
    // increasing stock, requires admin. ----
    // Product reviews — world-readable; a signed-in user writes their own
    // (with a valid 1–5 rating and no admin-only fields); admins moderate.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.get('hidden', false) == false
        && !('adminReply' in request.resource.data);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.get('hidden', false) ==
             resource.data.get('hidden', false)
        && request.resource.data.get('adminReply', '') ==
             resource.data.get('adminReply', '')
      );
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= resource.data.stock
      );
    }

    // ---- users: owners manage their own doc; role is not client-writable ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'customer';
      // Admins may change anything. A customer can edit their own profile but
      // NEVER the admin-managed fields (role, discount, blocked, notes).
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('discountPercent', 0) ==
             resource.data.get('discountPercent', 0)
        && request.resource.data.get('blocked', false) ==
             resource.data.get('blocked', false)
        && request.resource.data.get('adminNotes', '') ==
             resource.data.get('adminNotes', '')
      );
      allow delete: if false;
    }

    // ---- carts: private to the owner ----
    match /carts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- orders ----
    // Customers create their own orders; the order must be internally
    // consistent and start in a clean state. Customers can read their own
    // orders but never modify them. Admins read all and update status/payment.
    //
    // NOTE: line prices are validated against the catalogue manually before
    // dispatch (low volume). Phase 2 moves total calculation into a Cloud
    // Function for fully server-trusted pricing.
    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        // Blocked accounts cannot place orders.
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('blocked', false) == false
        && request.resource.data.status == 'placed'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.items.size() > 0
        // Discount % on the order must equal the rate set on the profile.
        && request.resource.data.get('discountPercent', 0) ==
             get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('discountPercent', 0)
        && request.resource.data.get('discountAmount', 0) >= 0
        && request.resource.data.get('discountAmount', 0) <=
             request.resource.data.subtotal
        && request.resource.data.total >= 0
        && request.resource.data.total == request.resource.data.subtotal
             + request.resource.data.delivery
             - request.resource.data.get('discountAmount', 0);
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      // Admins update freely. A customer may only cancel their OWN order, and
      // only while it is still 'placed' (changing nothing but the status).
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'placed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if false;
    }
  }
}
